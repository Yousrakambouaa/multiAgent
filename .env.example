# Copy this file to .env. Keep .env local; never put real credentials in this file.
# Run commands from the repository root. Restart the bot after configuration changes.
# Existing shell environment variables take precedence over .env.

# Telegram transport. Create your own bot with Telegram's BotFather.
TELEGRAM_BOT_TOKEN=
# Setup-only 0 authorizes nobody. Start the bot, send /myid, stop it, then replace
# 0 with your numeric Telegram user ID before using protected job commands.
TELEGRAM_ALLOWED_USER_ID=0

# Select one provider: openrouter or dahl. Credentials are never shared between them.
AI_PROVIDER=openrouter
# Use a regular OpenRouter inference key, not a management/provisioning key.
OPENROUTER_API_KEY=
# Fill these only when using Dahl. Its integration is text-only in this studio.
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
# Optional comma-separated preferences from Dahl's own live model catalog.
DAHL_MODEL_SUPERVISOR=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_DESIGNER=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_DEVELOPER=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_ART=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_QA=MiniMaxAI/MiniMax-M2.7

# OpenRouter hybrid policy uses task price/fit, measured checks and advisory
# benchmark metadata. studio_models.json holds preferences, not an allowlist.
# An explicitly saved job policy remains attached to that job.
STUDIO_OPENROUTER_POLICY=hybrid
# Set 1 to allow only zero-priced OpenRouter text/image endpoints.
# Free endpoints can still have quota, availability, and capability restrictions.
STUDIO_FREE_ONLY=0
# These legacy routing settings apply to Dahl; OpenRouter discovers alternatives.
STUDIO_MODEL_SELECTION=configured
STUDIO_MODEL_FALLBACK_SCOPE=configured
STUDIO_AUTO_MODEL_FALLBACK=1
# Requested only when the selected OpenRouter model advertises suitable reasoning.
STUDIO_REASONING_EFFORT=medium
# Whole-request deadlines in seconds; transport/read limits also apply.
STUDIO_API_TIMEOUT_SECONDS=600
OPENROUTER_REQUEST_TIMEOUT_SECONDS=180

# Local API caps are spending permission, not proof of provider credits.
# Default cap for a new game and maximum accepted by /budget or --budget:
STUDIO_JOB_BUDGET_USD=10
STUDIO_MAX_JOB_BUDGET_USD=50
# Optional single setting overrides BOTH legacy values above when uncommented.
# MAX_JOB_BUDGET_USD=10

# Use this project's Unity version; change the path for your own installation.
UNITY_EDITOR_PATH=C:/Program Files/Unity/Hub/Editor/6000.3.24f1/Editor/Unity.exe
# 1 requests Android packaging by default. Install Android Build Support first.
# Set 0 while testing desktop prototypes; --android still requests an APK.
STUDIO_BUILD_ANDROID=1
# auto: use/open the matching Editor with MCP; with MCP disabled, closed
# projects use batch mode. live requires MCP; batch requires the project closed.
STUDIO_UNITY_MODE=auto
STUDIO_UNITY_STARTUP_TIMEOUT=600

# Optional framework wrappers; direct uses the same metered gateway without them.
STUDIO_DESIGNER_BACKEND=crewai
STUDIO_QA_BACKEND=autogen

# Unity bridge. Requires Git and uv/uvx on PATH. New projects receive the pinned
# Coplay Unity package and project-local startup configuration automatically.
# Set 0 only if you intend to use the documented batch-mode alternative.
STUDIO_UNITY_MCP_ENABLED=1
# Windows virtualenv path avoids depending on shell activation or a global uvx.
# On macOS/Linux use .venv/bin/uvx, or use uvx when it is on PATH.
STUDIO_UNITY_MCP_COMMAND=.venv/Scripts/uvx.exe
STUDIO_UNITY_MCP_ARGS_JSON='["--from","mcpforunityserver==10.3.0","mcp-for-unity"]'
STUDIO_UNITY_MCP_TIMEOUT=20
