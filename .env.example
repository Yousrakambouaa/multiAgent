# Keep real secrets in .env, which is ignored by Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Select openrouter (default) or dahl. Restart the bot after changes.
AI_PROVIDER=openrouter
# Regular inference key from /settings/keys; management/provisioning keys cannot run models.
OPENROUTER_API_KEY=
# Dahl uses separate credentials and exact IDs from its /v1/models catalog.
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
# Optional comma-separated fallback IDs, in preference order, per agent.
# UI uses designer's models; scene repair uses developer's models.
# Dahl serves text only; art retains existing local/unavailable/procedural paths.
DAHL_MODEL_SUPERVISOR=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_DESIGNER=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_DEVELOPER=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_ART=MiniMaxAI/MiniMax-M2.7
DAHL_MODEL_QA=MiniMaxAI/MiniMax-M2.7
# Dahl selection settings; OpenRouter always discovers affordable alternatives.
STUDIO_MODEL_SELECTION=configured
STUDIO_MODEL_FALLBACK_SCOPE=configured
STUDIO_PAID_ONLY=0
STUDIO_REASONING_EFFORT=medium
STUDIO_API_TIMEOUT_SECONDS=600
OPENROUTER_REQUEST_TIMEOUT_SECONDS=180
# Rank account-visible paid models first; every call still must fit the job budget.
STUDIO_ALLOW_PAID_MODELS=1
# Optional strict free-only mode; leave 0 for automatic allowance adaptation.
STUDIO_FREE_ONLY=0
# Legacy fallback setting for Dahl; OpenRouter always discovers eligible alternatives.
STUDIO_AUTO_MODEL_FALLBACK=1
UNITY_EDITOR_PATH=C:\Program Files\Unity\Hub\Editor\6000.3.24f1\Editor\Unity.exe
STUDIO_JOB_BUDGET_USD=10
STUDIO_MAX_JOB_BUDGET_USD=50
# Optional single maximum overrides both legacy budget settings above.
# MAX_JOB_BUDGET_USD=10
STUDIO_BUILD_ANDROID=1
# auto opens the approved job in a visible Unity Editor and uses its MCP bridge.
# Set STUDIO_UNITY_MCP_ENABLED=0 to opt out; auto then uses batch only for closed projects.
STUDIO_UNITY_MODE=auto
STUDIO_UNITY_STARTUP_TIMEOUT=600
STUDIO_DESIGNER_BACKEND=crewai
STUDIO_QA_BACKEND=autogen
# Coplay MCP for Unity is added to new job projects and started in the matching open Editor.
# Set to 0 to opt out; the bot still uses batch mode for a closed project.
STUDIO_UNITY_MCP_ENABLED=1
STUDIO_UNITY_MCP_COMMAND=uvx
STUDIO_UNITY_MCP_ARGS_JSON='["--from","mcpforunityserver==10.3.0","mcp-for-unity"]'
STUDIO_UNITY_MCP_TIMEOUT=20
